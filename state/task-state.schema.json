{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentTaskState",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "title",
    "status",
    "owner",
    "goal",
    "scope",
    "acceptance_criteria",
    "retries",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-[a-zA-Z0-9_\\-]+$"
    },
    "project_id": { "type": "string" },
    "title": { "type": "string", "minLength": 5 },
    "mode": {
      "type": "string",
      "enum": ["direct", "quick", "standard", "consult"]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "draft_review",
        "planned",
        "ready",
        "writing",
        "validating",
        "reviewing",
        "consulting",
        "done",
        "blocked",
        "failed"
      ]
    },
    "owner": {
      "type": "string",
      "enum": ["router", "writer", "validator", "reviewer", "human"]
    },
    "model": { "type": "string" },
    "goal": { "type": "string" },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 50
    },
    "forbidden_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "ultra"]
    },
    "allow_scope_expansion": { "type": "boolean" },
    "justification": { "type": "string" },
    "approval": {
      "type": ["object", "null"],
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string" },
        "scope_hash": { "type": "string" }
      }
    },
    "scope_expansions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_report": {
      "type": ["object", "null"],
      "properties": {
        "final_status": { "type": "string", "enum": ["done", "blocked", "failed"] },
        "mode": { "type": "string", "enum": ["direct", "quick", "standard", "consult"] },
        "modified_files": { "type": "array", "items": { "type": "string" } },
        "validation_passed": { "type": ["boolean", "null"] },
        "retries_used": { "type": "integer" },
        "blocker_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "reported_at": { "type": "string" }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "writer_hub_workflow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "role", "action"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "role": { "type": "string" },
          "tier": { "type": "string" },
          "action": { "type": "string", "enum": ["draft_spec", "apply_patch"] },
          "inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "output_artifact": { "type": "string" },
          "allow_skip_spec": { "type": "boolean" },
          "model": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "error_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt", "stage", "error_hash", "summary"],
        "properties": {
          "attempt": { "type": "integer" },
          "stage": { "type": "string", "enum": ["apply", "validate", "review"] },
          "error_hash": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "validation_result": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "command_results": { "type": "array" }
      }
    },
    "review_result": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "rubric_scores": {
          "type": "object",
          "properties": {
            "correctness": { "type": "boolean" },
            "safety": { "type": "boolean" },
            "scope_adherence": { "type": "boolean" },
            "testability": { "type": "boolean" }
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
