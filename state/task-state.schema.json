{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentTaskState",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "title",
    "status",
    "owner",
    "goal",
    "scope",
    "acceptance_criteria",
    "retries",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "project_id": { "type": "string" },
    "title": { "type": "string", "minLength": 5 },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "ready",
        "writing",
        "validating",
        "reviewing",
        "done",
        "blocked",
        "failed"
      ]
    },
    "owner": {
      "type": "string",
      "enum": ["router", "writer", "validator", "reviewer", "human"]
    },
    "goal": { "type": "string" },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 5
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "error_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt", "stage", "error_hash", "summary"],
        "properties": {
          "attempt": { "type": "integer" },
          "stage": { "type": "string", "enum": ["apply", "validate", "review"] },
          "error_hash": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "validation_result": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "command_results": { "type": "array" }
      }
    },
    "review_result": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "rubric_scores": {
          "type": "object",
          "properties": {
            "correctness": { "type": "boolean" },
            "safety": { "type": "boolean" },
            "scope_adherence": { "type": "boolean" },
            "testability": { "type": "boolean" }
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
